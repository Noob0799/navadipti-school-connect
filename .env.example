# Postgres connection string, for example:
# postgresql://postgres:<password>@localhost:5432/navadipti_school_connect?schema=public
DATABASE_URL=""

# Signs login sessions. Use a long random value, different on every environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Development only. Password for the demo principal, teacher and student accounts that the seed creates.
SEED_DEV_PASSWORD=""

# Production. The seed creates this principal account when set. Leave blank on development machines.
SEED_PRINCIPAL_PHONE=""
SEED_PRINCIPAL_PASSWORD=""
SEED_PRINCIPAL_NAME=""

# S3-compatible object storage for uploaded files (homework/test/syllabus attachments).
# Using Supabase Storage: Project Settings > Storage > S3 Connection to get these values,
# and create the bucket under Storage in the left sidebar.
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
